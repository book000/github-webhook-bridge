# Exclude Designer and resx files from analysis
[*.{Designer.cs,resx}]
generated_code = true

# Exclude EF Core migration files from analysis
[Migrations/*.cs]
generated_code = true

# =========================
# Rule relaxations specific to the test project
# =========================
[tests/**.cs]
# Allow the xUnit Method_Scenario_Expected underscore naming convention
dotnet_diagnostic.CA1707.severity = none
# xUnit [Fact]/[Theory] methods do not need an Async suffix
dotnet_diagnostic.IDE1006.severity = none
# HMAC-SHA256 hex strings are lowercase by specification, so ToLowerInvariant is allowed
dotnet_diagnostic.CA1308.severity = none
# Instantiation through reflection by JsonSerializer.Deserialize<T> is not visible to the analyzer, so it is allowed
dotnet_diagnostic.CA1812.severity = none
