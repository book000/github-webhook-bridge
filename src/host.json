{
  "version": "2.0",
  "telemetryMode": "OpenTelemetry",
  "extensions": {
    "http": {
      "routePrefix": ""
    },
    "queues": {
      "messageEncoding": "base64",
      "maxDequeueCount": 10,
      "visibilityTimeout": "00:00:30",
      "batchSize": 1,
      "newBatchThreshold": 0
    }
  }
}
