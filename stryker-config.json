{
  "stryker-config": {
    "solution": "GitHubWebhookBridge.slnx",
    "mutate": [
      "Actions/Impl/**/*.cs",
      "Actions/BaseAction.cs",
      "Actions/ActionFactory.cs",
      "Functions/WebhookFunction.cs",
      "Utils/SignatureValidator.cs",
      "Utils/EmbedHelper.cs",
      "Managers/MuteManager.cs"
    ],
    "reporters": ["html", "cleartext", "json"],
    "report-file-name": "stryker-report",
    "thresholds": {
      "high": 80,
      "low": 65,
      "break": 60
    },
    "verbosity": "info"
  }
}
